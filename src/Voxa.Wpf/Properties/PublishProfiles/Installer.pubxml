<?xml version="1.0" encoding="utf-8"?>
<!-- For installer\Voxa.iss. Framework-dependent: uses the .NET 10 Desktop Runtime installed on the PC
     (the installer downloads and installs it when missing), so the install has no copy of the runtime.
     Measured on Voxa 0.1: self-contained 269 MB / ~520 files -> framework-dependent ~98 MB / ~55 files. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- ReadyToRun measured: no measurable start-up gain (the framework is precompiled already). -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- WPF doesn't support trimming (NETSDK1168). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- No cs\, de\, ja\... folders with translated framework/library messages: the app UI is English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>..\..\artifacts\publish\installer\</PublishDir>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!-- One Voxa.exe without installation (copy anywhere and run). Models: a "models" folder next to the exe,
     or any folder chosen in Settings → Models.
     Measured: 106 MB; first start +1.4 s (native libraries are extracted to %TEMP%\.net\Voxa\), then ~1.15 s.
     Without compression: 262 MB and ~0.2 s faster start. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Without it onnxruntime.dll, sherpa-onnx and llama.dll would stay next to the exe as loose files. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\artifacts\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>

<Window x:Class="Voxa.Wpf.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Voxa.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Voxa Overlay"
        Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False">

    <Grid Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="48,0,48,40"
                    Visibility="{Binding HasOverlayContent, Converter={StaticResource BoolToVisibility}}">

        <!-- "Czech detected": a few seconds after the spoken language was detected or changed -->
        <TextBlock Text="{Binding OverlayNoticeText}"
                   Visibility="{Binding HasOverlayNoticeText, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="20"
                   Foreground="#FF9A9AA3"
                   TextAlignment="Center"
                   Margin="0,0,0,8"
                   TextOptions.TextRenderingMode="Grayscale">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Previous (finished) caption line, dimmed -->
        <TextBlock Text="{Binding OverlayPreviousText}"
                   Visibility="{Binding HasOverlayPreviousText, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="#FFA1A1AA"
                   Opacity="0.85"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,0,6"
                   TextOptions.TextRenderingMode="Grayscale">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Visibility="{Binding HasOverlayText, Converter={StaticResource BoolToVisibility}}">

            <!-- Pulsing dot while recording -->
            <Ellipse Width="14" Height="14" Margin="0,4,16,0" VerticalAlignment="Center"
                     Fill="{StaticResource RecordBrush}"
                     Visibility="{Binding ShowRecordingIndicator, Converter={StaticResource BoolToVisibility}}">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FFE5484D" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                </Ellipse.Effect>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- Grey text; the soft dark shadow keeps it readable on light backgrounds -->
            <TextBlock Text="{Binding OverlayText}"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="38"
                       FontWeight="SemiBold"
                       Foreground="#FFD4D4D8"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       TextOptions.TextRenderingMode="Grayscale">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="1" Direction="270" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Original under the translation: small and grey, only with "Show original" -->
        <TextBlock Text="{Binding OverlayOriginalText}"
                   Visibility="{Binding HasOverlayOriginalText, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="24"
                   Foreground="#FF9A9AA3"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,6,0,0"
                   TextOptions.TextRenderingMode="Grayscale">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>
        </StackPanel>
    </Grid>
</Window>

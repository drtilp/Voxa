<Window x:Class="Voxa.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:Voxa.Wpf"
        xmlns:vm="clr-namespace:Voxa.Wpf.ViewModels"
        xmlns:asr="clr-namespace:Voxa.Core.Asr;assembly=Voxa.Core"
        xmlns:audio="clr-namespace:Voxa.Wpf.Audio"
        xmlns:views="clr-namespace:Voxa.Wpf.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static app:AppInfo.DisplayName}"
        Width="480"
        Height="680"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Icon="/Assets/Voxa.ico"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Main page → settings summary row: label, value, chevron -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="112" />
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main page -->
        <Grid x:Name="HomePage" Margin="24,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title + settings (gear) -->
            <Grid Margin="0,0,4,16">
                <TextBlock Text="Voxa" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Padding="9" ToolTip="Settings" Click="OnOpenSettings">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource WindowScroll}">
                <StackPanel>
                    <!-- Target language -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Translate to" Style="{StaticResource CardTitle}" />
                            <ComboBox Style="{StaticResource Dropdown}" ItemsSource="{Binding TargetLanguages}"
                                      SelectedItem="{Binding SelectedTargetLanguage}" ItemTemplate="{StaticResource LanguageItem}"
                                      IsEnabled="{Binding IsTranslationOff, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Name" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding IsTranslationOff, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Translation is off." />
                                <Hyperlink Click="OnOpenSettings" Foreground="{StaticResource TextBrush}">Choose a translator</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding TranslatorProblem}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding HasTranslatorProblem, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Audio source -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Source" Style="{StaticResource CardTitle}" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding AudioInputs}"
                                     SelectedItem="{Binding SelectedAudioInput}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type audio:AudioInput}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="System audio" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Static audio:AudioInput.Microphone}">
                                                            <Setter Property="Text" Value="Microphone" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Models: what runs now; changed in Settings -->
                    <Border Style="{StaticResource Card}" Padding="8">
                        <StackPanel>
                            <Button Style="{StaticResource RowButton}" Click="OnOpenSettings" ToolTip="Change in Settings">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="Speech to text" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedModel.Name, FallbackValue=None}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Visibility="Collapsed">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CloudIcon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedModel.Location}" Value="{x:Static asr:AsrModelLocation.Remote}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource RowButton}" Click="OnOpenSettings" ToolTip="Change in Settings">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11"
                                               Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,0,0" />
                                    <TextBlock Text="Translation" Style="{StaticResource RowLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedTranslationOption.Name, FallbackValue=None}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource CloudIcon}"
                                                   Visibility="{Binding SelectedTranslationOption.IsRemote, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Start / stop: always visible below the scrolling area -->
            <StackPanel Grid.Row="2" Margin="0,16,4,0">
                <Button Command="{Binding ToggleLiveCommand}" Content="{Binding LiveButtonText}"
                        Padding="16,12" FontSize="15" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource WindowBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,8,0,0"
                           Visibility="{Binding HasDetectedLanguage, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="Detected language:" />
                    <Run Text="{Binding DetectedLanguageName, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{StaticResource ErrorBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Settings page: same window, the main page is hidden meanwhile -->
        <views:SettingsPage x:Name="SettingsPage" Visibility="Collapsed" BackRequested="OnSettingsBack" />
    </Grid>
</Window>

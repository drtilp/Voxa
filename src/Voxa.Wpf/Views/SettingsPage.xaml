<UserControl x:Class="Voxa.Wpf.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Voxa.Wpf.ViewModels"
             xmlns:asr="clr-namespace:Voxa.Core.Asr;assembly=Voxa.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             d:DesignWidth="480" d:DesignHeight="680">

    <UserControl.Resources>
        <!-- Record button: grey with a red dot; red with a square while recording -->
        <Style x:Key="RecordButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="112" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="{StaticResource RecordBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource RecordBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Model lists grouped like the cards: LOCAL / REMOTE / API -->
        <CollectionViewSource x:Key="AsrModels" Source="{Binding Models}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Location" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="Translators" Source="{Binding TranslationOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="ModelList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModelItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <!-- The page scrolls, not the list: otherwise the mouse wheel stops over the list -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <!-- Read-only model (voice / language detection): check or warning icon + name -->
        <Style x:Key="StatusIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xE73E;" />
            <Setter Property="Foreground" Value="#FF6FCF97" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" Style="{StaticResource WindowScroll}">
        <StackPanel Margin="24,20,20,24">
            <!-- Header: back + title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Padding="9" ToolTip="Back (Esc)" Click="OnBack" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="MODELS" Style="{StaticResource SectionLabel}" />

            <!-- Speech to text -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Speech to text" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Turns speech into the transcript. Local models run on this PC, remote ones on the cloud server."
                               Style="{StaticResource CardDescription}" />
                    <ListBox Style="{StaticResource ModelList}" ItemsSource="{Binding Source={StaticResource AsrModels}}"
                             SelectedItem="{Binding SelectedModel}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource ModelGroupHeader}" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type asr:AsrModelOption}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Cloud" Style="{StaticResource CloudIcon}" Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Location}" Value="{x:Static asr:AsrModelLocation.Remote}">
                                        <Setter TargetName="Cloud" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button HorizontalAlignment="Left" Content="Add .onnx model…" Margin="0,8,0,0" Command="{Binding AddOnnxModelCommand}" />
                </StackPanel>
            </Border>

            <!-- Translation -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Translation" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Finished sentences are translated and shown in the overlay. The target language is on the main page."
                               Style="{StaticResource CardDescription}" />
                    <ListBox Style="{StaticResource ModelList}" ItemsSource="{Binding Source={StaticResource Translators}}"
                             SelectedItem="{Binding SelectedTranslationOption}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource ModelGroupHeader}" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TranslationOption}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ModelPath}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource CloudIcon}"
                                               Visibility="{Binding IsRemote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button HorizontalAlignment="Left" Content="Add .gguf model…" Margin="0,8,0,0" Command="{Binding AddTranslationModelCommand}" />

                    <!-- Azure settings -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsAzureTranslator, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Region" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,0,6">
                            <Run Text="Key" />
                            <Run Foreground="#FF6FCF97">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAzureKey}" Value="True">
                                                <Setter Property="Text" Value="✓ saved, encrypted" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>

                        <TextBox Grid.Row="1" Text="{Binding AzureRegion, UpdateSourceTrigger=LostFocus}" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AzureKeyBox" />
                            <Button Grid.Column="1" Content="Save key" Margin="8,0,0,0" Click="OnSaveAzureKey" />
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="Azure portal → Create resource → Translator, pricing tier F0 (free, 2M characters / month) → Keys and Endpoint." />
                    </Grid>

                    <!-- DeepL settings -->
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDeepLTranslator, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6">
                            <Run Text="API key" />
                            <Run Foreground="#FF6FCF97">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDeepLKey}" Value="True">
                                                <Setter Property="Text" Value="✓ saved, encrypted" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="DeepLKeyBox" />
                            <Button Grid.Column="1" Content="Save key" Margin="8,0,0,0" Click="OnSaveDeepLKey" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                                   Text="deepl.com → API → account → API keys. Free keys end with ':fx' and use the free endpoint automatically." />
                    </StackPanel>

                    <TextBlock Text="{Binding TranslatorInfo}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasTranslatorInfo, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding TranslatorProblem}" Foreground="{StaticResource ErrorBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasTranslatorProblem, Converter={StaticResource BoolToVisibility}}" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOriginal}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Show original" FontWeight="SemiBold" />
                            <TextBlock Text="Small grey transcript under the translation (also shows sentences in progress)."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Voice detection (not selectable) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Voice detection" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Finds where sentences start and end, for local speech to text. The cloud server has its own."
                               Style="{StaticResource CardDescription}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVadModel}" Value="False">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding VadModelText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Language detection (not selectable) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Language detection" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Optional: shows which language is spoken (&quot;Czech detected&quot;). The cloud server has its own."
                               Style="{StaticResource CardDescription}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLanguageIdModel}" Value="False">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LanguageIdModelText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Models folder + downloads -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Models folder" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Voxa looks for models in this folder. Models elsewhere on the PC can be added one by one above."
                               Style="{StaticResource CardDescription}" Margin="0,4,0,12" />

                    <TextBlock FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6">
                        <Run Text="Models folder" />
                        <Run>
                            <Run.Style>
                                <Style TargetType="Run">
                                    <!-- Not a local Text: a local value would win over the trigger -->
                                    <Setter Property="Text" Value="(default)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefaultModelsFolder}" Value="False">
                                            <Setter Property="Text" Value="" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                    <TextBox Text="{Binding ModelsFolder, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding ModelsFolder}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Change…" Command="{Binding BrowseModelsFolderCommand}" />
                        <Button Content="Open" Margin="8,0,0,0" Command="{Binding OpenModelsFolderCommand}" />
                        <Button Content="Use default" Margin="8,0,0,0" Command="{Binding ResetModelsFolderCommand}" />
                    </StackPanel>

                    <!-- Download our models into the folder above -->
                    <TextBlock Text="Download models" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,16,0,2" />
                    <TextBlock Text="Into the models folder above, from Hugging Face. An interrupted download continues where it stopped."
                               FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Opacity="0.7" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ModelDownloadItems}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModelDownloadItem}">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <!-- One round button per state: ↓ download → progress ring with ■ stop → ✓ (hover: bin) -->
                                        <Grid Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <Button Style="{StaticResource CircleButton}" Command="{Binding DownloadCommand}"
                                                    ToolTip="Download"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" />
                                            </Button>
                                            <Button Style="{StaticResource CircleButton}" Command="{Binding CancelCommand}" BorderBrush="Transparent"
                                                    ToolTip="Stop (the download continues from here next time)"
                                                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Width="32" Height="32">
                                                    <Ellipse Stroke="{StaticResource ControlBrush}" StrokeThickness="2.5" />
                                                    <!-- 37.07 = π · (32 − 2.5) / 2.5 -->
                                                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5"
                                                             StrokeDashArray="{Binding Progress, Converter={x:Static vm:ProgressToDashConverter.Instance}, ConverterParameter=37.07}">
                                                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                                                    </Ellipse>
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="10" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource InstalledButton}" Command="{Binding DeleteCommand}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <TextBlock Text="APP" Style="{StaticResource SectionLabel}" />

            <!-- Cloud server (remote models) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cloud server" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CloudIcon}" FontSize="15" />
                    </StackPanel>
                    <TextBlock Text="Runs the remote models (marked with a cloud). The server sleeps when unused; the first start takes about 2 minutes."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <TextBlock Text="Server address" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=LostFocus}" />


                    <Button HorizontalAlignment="Left" Content="Check connection" Margin="0,10,0,0" Command="{Binding CheckCloudCommand}" />
                    <TextBlock Text="{Binding CloudStatus}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasCloudStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Overlay test (Dev only) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Features.OverlayTest, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Button HorizontalAlignment="Left" Command="{Binding ToggleCaptionTestCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="Test ASR Overlay UI" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaptionTestRunning}" Value="True">
                                        <Setter Property="Content" Value="Stop ASR Overlay Test" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Audio test -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Features.AudioTest, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Audio test" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Records whatever is playing on the default output device into a WAV file."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource RecordButton}" Command="{Binding ToggleRecordingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" Margin="0,1,10,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource RecordBrush}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Rectangle Fill="White" RadiusX="2" RadiusY="2"
                                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <TextBlock Text="{Binding RecordButtonText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Margin="16,0"
                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{StaticResource SubtleTextBrush}" />

                        <Button Grid.Column="2" Content="Open folder" Command="{Binding OpenRecordingsFolderCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding LastRecordingPath, StringFormat=Saved: {0}}"
                               ToolTip="{Binding LastRecordingPath}"
                               Visibility="{Binding HasLastRecording, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                               Foreground="{StaticResource ErrorBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- About & updates -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold">
                        <Run Text="Voxa" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" />
                    </TextBlock>
                    <TextBlock Text="New versions come from the GitHub Releases of this project."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdatesOnStart}">
                        <TextBlock Text="Check for updates on start" FontWeight="SemiBold" />
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" />
                        <Button Margin="8,0,0,0" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock>
                                <Run Text="Install" />
                                <Run Text="{Binding AvailableUpdate.Tag, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                        <Button Content="Releases" Margin="8,0,0,0" Command="{Binding OpenReleaseNotesCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Experimental (feature flags) -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Features.Experimental, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Experimental" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Features being tried out. They can change or disappear."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsFirstRunWizardEnabled}">
                        <StackPanel>
                            <TextBlock Text="Model wizard on first start" FontWeight="SemiBold" />
                            <TextBlock Text="Variant A: choose models in the app. Off = variant B, the choice is in the installer."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <Button HorizontalAlignment="Left" Content="Open setup wizard" Margin="0,12,0,0" Command="{Binding OpenSetupWizardCommand}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Closing Voxa windows keeps it running in the system tray."
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="2,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

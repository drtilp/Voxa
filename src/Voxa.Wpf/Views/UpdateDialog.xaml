<Window x:Class="Voxa.Wpf.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Voxa.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Voxa Update"
        Width="460"
        SizeToContent="Height"
        MaxHeight="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Icon="/Assets/Voxa.ico"
        UseLayoutRounding="True">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding UpdateHeadline}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12">
            <Run Text="You have" />
            <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
            <Run Text="— Voxa closes, updates and starts again. Your settings and models stay." />
        </TextBlock>

        <!-- Release notes (message of the git tag + commits) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" MaxHeight="240">
            <ScrollViewer Style="{StaticResource WindowScroll}">
                <TextBlock Text="{Binding AvailableUpdate.Notes}" TextWrapping="Wrap" FontSize="13" />
            </ScrollViewer>
        </Border>

        <!-- Progress while downloading -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0"
                    Visibility="{Binding HasUpdateStatus, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding UpdateStatus}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0"
                         Background="{StaticResource ControlBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Button Content="Skip this version" HorizontalAlignment="Left" Click="OnSkip"
                    IsEnabled="{Binding IsUpdating, Converter={x:Static vm:InverseBooleanConverter.Instance}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Later" MinWidth="88" Click="OnLater" IsCancel="True" />
                <Button Content="Update now" MinWidth="110" Margin="8,0,0,0" FontWeight="SemiBold" IsDefault="True"
                        Command="{Binding InstallUpdateCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource AccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

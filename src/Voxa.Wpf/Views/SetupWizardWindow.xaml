<Window x:Class="Voxa.Wpf.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Voxa.Wpf.ViewModels"
        xmlns:setup="clr-namespace:Voxa.Wpf.Setup"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}"
        Title="Voxa Setup"
        Width="560"
        Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Icon="/Assets/Voxa.ico"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="OfferTemplate" DataType="{x:Type setup:ModelOffer}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Recommended" FontSize="11" Foreground="#FF6FCF97" />
                    </Border>
                    <TextBlock Text="{Binding Size}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding StepCaption}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding CurrentStep.Title}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                <Setter Property="Text" Value="Ready to go" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SubtleTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding CurrentStep.Subtitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                <Setter Property="Text" Value="This is what Voxa will use. Everything can be changed later in Settings." />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Step: choices for one model role -->
        <ScrollViewer Grid.Row="1">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource WindowScroll}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSummary}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel DataContext="{Binding CurrentStep}">
                <ListBox ItemsSource="{Binding Offers}" SelectedItem="{Binding SelectedOffer}"
                         ItemContainerStyle="{StaticResource OfferCard}" ItemTemplate="{StaticResource OfferTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <!-- Own model: path + browse -->
                <Grid Margin="0,4,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CustomPath, Mode=OneWay}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Summary -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource WindowScroll}"
                      Visibility="{Binding IsSummary, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Summary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SummaryLine}">
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Role}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                                    <TextBlock Text="{Binding Choice}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Models folder" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,8,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ModelsFolder, Mode=OneWay}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Command="{Binding ChangeFolderCommand}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Skip" HorizontalAlignment="Left" Command="{Binding SkipCommand}"
                    ToolTip="Close without changes; the wizard shows again on the next start." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Back" Command="{Binding BackCommand}" MinWidth="88" />
                <Button Content="{Binding NextText}" Command="{Binding NextCommand}" MinWidth="88" Margin="8,0,0,0"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource WindowBrush}"
                        BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

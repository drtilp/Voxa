<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (tray). WPF has no built-in tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Voxa</AssemblyName>
    <RootNamespace>Voxa.Wpf</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Exe icon (Explorer, taskbar, installer shortcuts). Generated by tools/IconGen. -->
    <ApplicationIcon>Assets\Voxa.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also as a WPF resource: window icons and the tray icon load it via pack URI. -->
    <Resource Include="Assets\Voxa.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms global usings clash with WPF (Application, Button, Color...). Import them explicitly where needed. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" />
  </ItemGroup>

  <!-- LLamaSharp.Backend.Cpu copies the native libraries of every platform (Linux, macOS, ARM) through the
       Translators.Llama reference, because that library has no RuntimeIdentifier. A win-x64 publish never
       loads them: drop them from the publish output. -->
  <Target Name="RemoveForeignNativeRuntimes" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <_ForeignRuntimeFile Include="@(ResolvedFileToPublish)"
                           Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes\'))
                                      and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('\$(RuntimeIdentifier)\'))" />
      <!-- Contains, not StartsWith: the package's Link produces "runtimes\\win-x64\..." (double backslash). -->
      <ResolvedFileToPublish Remove="@(_ForeignRuntimeFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Voxa.Core\Voxa.Core.csproj" />
    <ProjectReference Include="..\Voxa.Engines.SherpaOnnx\Voxa.Engines.SherpaOnnx.csproj" />
    <ProjectReference Include="..\Voxa.Translators.Azure\Voxa.Translators.Azure.csproj" />
    <ProjectReference Include="..\Voxa.Translators.DeepL\Voxa.Translators.DeepL.csproj" />
    <ProjectReference Include="..\Voxa.Translators.Llama\Voxa.Translators.Llama.csproj" />
    <ProjectReference Include="..\Voxa.Remote\Voxa.Remote.csproj" />
  </ItemGroup>

</Project>
